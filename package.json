{
  "name": "client-side-image-compressor",
  "version": "1.0.0",
  "description": "100% client-side, privacy-first image compressor built with React, TypeScript, Tailwind CSS, and HTML5 Canvas.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "image-compressor",
    "image-optimization",
    "client-side",
    "privacy-first",
    "react",
    "typescript",
    "tailwindcss",
    "canvas",
    "webp",
    "jpeg",
    "png"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "file-saver": "^2.0.5",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
